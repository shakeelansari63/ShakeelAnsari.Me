RewriteEngine On

# Let API requests pass through to api/ subdirectory
RewriteRule ^api/ - [L]

# Dynamic sitemap from API
RewriteRule ^sitemap\.xml$ api/public/sitemap.php [L]

# SPA fallback - render per-URL HTML shell via page.php for non-file routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ api/public/page.php [L]
